node_modules/
backend/node_modules/
frontend/node_modules/
frontend/build/

# Environment — NEVER commit real credentials
backend/.env

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
tweller-flow.backup/

# Scratch build output. Never commit a *mutable* zip — a hand-made one
# (tweller-flow.zip) used to sit in the repo root, went stale, and kept
# colliding with `git pull` because git can't merge a binary that keeps
# changing under the same name.
/dist/
*.zip

# releases/ is the exception, and the reason the rule above is safe: each
# file there is named for its plugin version, written once, and never
# modified again — so it can never conflict. Built automatically by the
# pre-commit hook when the version is bumped.
!releases/*.zip
